# Microservices .env — copy to .env and fill in values

# ── Secrets ──────────────────────────────────────────────────────────────────
SECRET_KEY=dev-secret-change-in-production-min-32-chars
ENCRYPTION_KEY=dev-enc-key-32bytes-change-prod!!

# ── Infrastructure ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://pauser:papass@localhost:5432/pa_system
REDIS_URL=redis://localhost:6379/0
KAFKA_SERVERS=localhost:9092

# ── AWS ───────────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
S3_BUCKET=pa-documents-hipaa
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Payer APIs ────────────────────────────────────────────────────────────────
UHC_CLIENT_ID=
UHC_CLIENT_SECRET=
AETNA_CLIENT_ID=
AETNA_CLIENT_SECRET=
BCBS_CLIENT_ID=
BCBS_CLIENT_SECRET=
CIGNA_CLIENT_ID=
CIGNA_CLIENT_SECRET=

# ── Email / SMS ───────────────────────────────────────────────────────────────
SENDGRID_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
SMTP_HOST=smtp.sendgrid.net
