# ╔══════════════════════════════════════════════════════════════════════════╗
# ║  AI Prior Authorization System — Environment Variables                   ║
# ║  Copy to .env and fill in production values                              ║
# ║  NEVER commit .env to version control                                    ║
# ╚══════════════════════════════════════════════════════════════════════════╝

# ── Application ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
# ENVIRONMENT=production

# ── Security (REQUIRED — generate strong random values for production) ────────
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_MIN_32_CHARS_XXXX
# AES-256 key for PHI encryption at rest (NFR-105)
# Generate with: python3 -c "import secrets; print(secrets.token_bytes(32).hex())"
ENCRYPTION_KEY=CHANGE_ME_AES256_KEY_32BYTES_PROD!!

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://pauser:papass@postgres:5432/pa_system
DB_PASSWORD=papass
DB_PORT=5432
# Production: use managed RDS instance
# DATABASE_URL=postgresql+asyncpg://pauser:STRONG_PASSWORD@your-rds-endpoint.us-east-1.rds.amazonaws.com:5432/pa_system

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://:redispass@redis:6379/0
REDIS_PASSWORD=redispass
REDIS_PORT=6379

# ── Kafka ─────────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_PORT=9092

# ── AWS (Required for S3 document storage and Textract OCR) ──────────────────
AWS_REGION=us-east-1
# Create IAM user with S3 and Textract permissions
AWS_ACCESS_KEY_ID=PLACEHOLDER_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=PLACEHOLDER_AWS_SECRET_ACCESS_KEY
S3_DOCUMENTS_BUCKET=pa-documents-hipaa-dev
# Production: Use IAM roles instead of access keys

# ── Payer API Credentials ─────────────────────────────────────────────────────
# UnitedHealthcare
UHC_CLIENT_ID=PLACEHOLDER_UHC_CLIENT_ID
UHC_CLIENT_SECRET=PLACEHOLDER_UHC_CLIENT_SECRET
UHC_API_BASE=https://api.uhc.com/prior-auth/v2

# Aetna
AETNA_CLIENT_ID=PLACEHOLDER_AETNA_CLIENT_ID
AETNA_CLIENT_SECRET=PLACEHOLDER_AETNA_CLIENT_SECRET
AETNA_API_BASE=https://api.aetna.com/prior-auth/v1

# Blue Cross Blue Shield
BCBS_API_KEY=PLACEHOLDER_BCBS_API_KEY
BCBS_API_BASE=https://api.bcbs.com/prior-auth/v1

# Cigna
CIGNA_CLIENT_ID=PLACEHOLDER_CIGNA_CLIENT_ID
CIGNA_CLIENT_SECRET=PLACEHOLDER_CIGNA_CLIENT_SECRET
CIGNA_API_BASE=https://api.cigna.com/prior-auth/v1

# Humana
HUMANA_API_KEY=PLACEHOLDER_HUMANA_API_KEY

# CVS/Caremark (PBM)
CVS_API_KEY=PLACEHOLDER_CVS_API_KEY
CVS_API_BASE=https://api.cvscaremark.com/pa/v1

# ── Clinical Guidelines APIs ──────────────────────────────────────────────────
# MCG Care Guidelines (TR-301)
MCG_API_KEY=PLACEHOLDER_MCG_API_KEY
MCG_API_BASE=https://api.mcg.com/criteria/v2

# InterQual (TR-302)
INTERQUAL_API_KEY=PLACEHOLDER_INTERQUAL_API_KEY
INTERQUAL_API_BASE=https://api.interqual.com/criteria/v1

# ── Notification Services ─────────────────────────────────────────────────────
# SendGrid (email notifications)
SENDGRID_API_KEY=PLACEHOLDER_SENDGRID_API_KEY
SENDGRID_FROM_EMAIL=noreply@pa-system.hospital.org
SENDGRID_FROM_NAME=PA Authorization System

# Twilio (SMS notifications)
TWILIO_ACCOUNT_SID=PLACEHOLDER_TWILIO_ACCOUNT_SID
TWILIO_AUTH_TOKEN=PLACEHOLDER_TWILIO_AUTH_TOKEN
TWILIO_FROM_NUMBER=+15550000000

# Fax API (SRFax or eFax)
FAX_API_KEY=PLACEHOLDER_FAX_API_KEY
FAX_FROM_NUMBER=+15559876543

# ── EHR Integration ───────────────────────────────────────────────────────────
# Epic FHIR R4 endpoint
EPIC_FHIR_BASE_URL=https://fhir.epic.com/interconnect-fhir-oauth/api/FHIR/R4
EPIC_CLIENT_ID=PLACEHOLDER_EPIC_CLIENT_ID
EPIC_PRIVATE_KEY_PATH=/secrets/epic-private-key.pem

# Cerner FHIR R4
CERNER_FHIR_BASE_URL=https://fhir-ehr.cerner.com/r4
CERNER_CLIENT_ID=PLACEHOLDER_CERNER_CLIENT_ID

# ── AI/ML Model Settings ──────────────────────────────────────────────────────
# HuggingFace models (auto-downloaded on first startup)
BIOBERT_MODEL_ID=dmis-lab/biobert-v1.1
CLINICALBERT_MODEL_ID=emilyalsentzer/Bio_ClinicalBERT
PUBMEDBERT_MODEL_ID=microsoft/BiomedNLP-PubMedBERT-base-uncased-abstract
MODELS_CACHE_DIR=/models
USE_GPU=0
# Set USE_GPU=1 if NVIDIA GPU available (recommended for production)

# Model performance thresholds
AUTO_APPROVE_THRESHOLD=0.92
AUTO_DENY_THRESHOLD=0.15
ENABLE_RAG_ENGINE=true

# ── SSO Configuration (TR-305) ────────────────────────────────────────────────
# SAML 2.0
SAML_IDP_METADATA_URL=PLACEHOLDER_SAML_IDP_METADATA_URL
SAML_SP_ENTITY_ID=https://pa-system.hospital.org/saml/metadata
SAML_SP_ACS_URL=https://pa-system.hospital.org/saml/acs

# OAuth 2.0 / OIDC
OAUTH_CLIENT_ID=PLACEHOLDER_OAUTH_CLIENT_ID
OAUTH_CLIENT_SECRET=PLACEHOLDER_OAUTH_CLIENT_SECRET
OAUTH_AUTHORITY=https://login.microsoftonline.com/YOUR_TENANT_ID

# ── Token Settings ────────────────────────────────────────────────────────────
ACCESS_TOKEN_TTL_MINUTES=60
REFRESH_TOKEN_TTL_DAYS=7
# HIPAA session timeout: 15 minutes of inactivity (enforced in frontend)
SESSION_TIMEOUT_MINUTES=15

# ── Observability ─────────────────────────────────────────────────────────────
GRAFANA_PASSWORD=admin123
# SIEM integration (Splunk/Datadog/QRadar) for NFR-107
SIEM_URL=

# ── Feature Flags ─────────────────────────────────────────────────────────────
ENABLE_AUTO_APPROVE=true
ENABLE_AUTO_DENY=false
ENABLE_FHIR_PUSH=true
ENABLE_KAFKA=true
ENABLE_MFA=false

# ── HIPAA Compliance Settings ─────────────────────────────────────────────────
# Data retention (TR-203)
AUDIT_LOG_RETENTION_YEARS=7
PHI_RETENTION_YEARS=10
# KMS key for data encryption (AWS)
KMS_KEY_ARN=PLACEHOLDER_KMS_KEY_ARN

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_BURST=200

# ── Demo Credentials (development only — change in production) ────────────────
# Provider:         provider1 / Provider@1234
# Reviewer RN:      reviewer1 / Review@1234
# Medical Director: meddir1   / Doctor@1234
# Member:           member1   / Member@1234
# Admin:            admin     / Admin@1234
# Ops Admin:        ops1      / Ops@1234
