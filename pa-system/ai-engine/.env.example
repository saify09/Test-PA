# PA AI Engine — Environment Variables
# Copy to .env and fill in real values before deploying

# ── Application ──────────────────────────────────────────────────────────────
APP_VERSION=1.0.0
ENVIRONMENT=development           # development | staging | production

# ── Security (CHANGE THESE IN PRODUCTION) ────────────────────────────────────
SECRET_KEY=dev-secret-change-in-production-min-32-chars
ENCRYPTION_KEY=dev-enc-key-32bytes-change-prod!!   # AES-256 key

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://pauser:papass@localhost:5432/pa_system

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Kafka ────────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
ENABLE_KAFKA=false                # Set true in production

# ── AWS ──────────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
S3_DOCUMENTS_BUCKET=pa-documents-hipaa
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── AI Thresholds ─────────────────────────────────────────────────────────────
AUTO_APPROVE_THRESHOLD=0.92
AUTO_DENY_THRESHOLD=0.15
ENABLE_AUTO_APPROVE=true
ENABLE_AUTO_DENY=false            # Requires compliance review before enabling

# ── Payer APIs ────────────────────────────────────────────────────────────────
UHC_API_BASE=https://api.uhc.com/prior-auth/v2
UHC_CLIENT_ID=
UHC_CLIENT_SECRET=
AETNA_API_BASE=https://api.aetna.com/prior-auth/v1
AETNA_CLIENT_ID=
AETNA_CLIENT_SECRET=
