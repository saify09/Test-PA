# ============================================================================
# terraform.tfvars.example
# PA System — Terraform Variable Values
# Copy to terraform.tfvars and fill in real values before running terraform apply
# NEVER commit terraform.tfvars to version control (it's in .gitignore)
# ============================================================================

# ── AWS Configuration ─────────────────────────────────────────────────────────
aws_region           = "us-east-1"
aws_account_id       = "123456789012"       # Replace with your AWS account ID
environment          = "production"          # production | staging | development

# ── Networking ────────────────────────────────────────────────────────────────
vpc_cidr             = "10.0.0.0/16"
availability_zones   = ["us-east-1a", "us-east-1b", "us-east-1c"]
# Private subnets for EKS worker nodes and RDS
private_subnet_cidrs = ["10.0.1.0/24", "10.0.2.0/24", "10.0.3.0/24"]
# Public subnets for ALB and NAT Gateways
public_subnet_cidrs  = ["10.0.101.0/24", "10.0.102.0/24", "10.0.103.0/24"]

# ── EKS Cluster ───────────────────────────────────────────────────────────────
cluster_name                  = "pa-system-production"
kubernetes_version            = "1.29"
node_group_instance_type      = "m6i.xlarge"      # 4 vCPU, 16 GB RAM
node_group_min_size           = 3
node_group_max_size           = 20
node_group_desired_size       = 5
node_group_disk_size_gb       = 100

# ── RDS PostgreSQL ────────────────────────────────────────────────────────────
db_instance_class             = "db.r6g.xlarge"   # 4 vCPU, 32 GB RAM
db_name                       = "pa_system"
db_username                   = "pa_admin"
db_password                   = "REPLACE_WITH_STRONG_PASSWORD_32_CHARS_MIN"
db_allocated_storage_gb       = 500
db_max_allocated_storage_gb   = 2000
db_multi_az                   = true
db_backup_retention_days      = 35               # 35 days for PITR (NFR-204)
db_deletion_protection        = true
db_parameter_group_family     = "postgres16"

# ── ElastiCache Redis ─────────────────────────────────────────────────────────
redis_node_type               = "cache.r6g.large"  # 2 vCPU, 13 GB RAM
redis_num_cache_nodes         = 2
redis_automatic_failover      = true
redis_at_rest_encryption      = true
redis_in_transit_encryption   = true

# ── S3 Buckets ────────────────────────────────────────────────────────────────
# Bucket names must be globally unique — update these
s3_documents_bucket           = "pa-system-documents-production-ACCOUNT_ID"
s3_audit_logs_bucket          = "pa-system-audit-logs-production-ACCOUNT_ID"
s3_ml_artifacts_bucket        = "pa-system-ml-artifacts-production-ACCOUNT_ID"
s3_backups_bucket             = "pa-system-backups-production-ACCOUNT_ID"

# ── KMS ───────────────────────────────────────────────────────────────────────
kms_key_deletion_window_days  = 30
enable_kms_key_rotation       = true

# ── ACM Certificate (for HTTPS) ───────────────────────────────────────────────
# Generate via: aws acm request-certificate --domain-name pa-system.yourhospital.org
acm_certificate_arn           = "arn:aws:acm:us-east-1:ACCOUNT_ID:certificate/REPLACE"
domain_name                   = "pa-system.yourhospital.org"
api_domain_name               = "api.pa-system.yourhospital.org"

# ── ECR Repositories (Docker images) ─────────────────────────────────────────
ecr_lifecycle_policy_days     = 90             # Keep images for 90 days

# ── CloudWatch Logging ────────────────────────────────────────────────────────
cloudwatch_log_retention_days = 2555           # 7 years for HIPAA (TR-203)

# ── Secrets Manager ───────────────────────────────────────────────────────────
# These are created by Terraform but values must be set manually in Secrets Manager:
#   pa-system/production/db-password
#   pa-system/production/redis-auth-token
#   pa-system/production/encryption-key    (AES-256, 32 bytes: openssl rand -base64 32)
#   pa-system/production/jwt-secret        (openssl rand -base64 64)
#   pa-system/production/uhc-client-id
#   pa-system/production/uhc-client-secret
#   pa-system/production/aetna-client-id
#   pa-system/production/aetna-client-secret
#   pa-system/production/sendgrid-api-key
#   pa-system/production/twilio-account-sid
#   pa-system/production/twilio-auth-token
#   pa-system/production/mcg-api-key
#   pa-system/production/interqual-api-key

# ── Monitoring / Alerting ─────────────────────────────────────────────────────
sns_alert_email               = "oncall@yourhospital.org"
pagerduty_integration_key     = "REPLACE_WITH_PAGERDUTY_KEY"

# ── Tagging ───────────────────────────────────────────────────────────────────
tags = {
  Project        = "PA-System"
  Environment    = "production"
  Owner          = "engineering@yourhospital.org"
  CostCenter     = "IT-12345"
  HIPAA          = "true"
  DataClass      = "PHI"
  Compliance     = "HIPAA,SOC2"
  ManagedBy      = "terraform"
}

# ── Disaster Recovery (NFR-301) ───────────────────────────────────────────────
# Cross-region replication for DR (RPO <1hr, RTO <4hr)
dr_region                     = "us-west-2"
enable_cross_region_replication = true

# ── Staging Overrides (used with -var-file=terraform.staging.tfvars) ──────────
# node_group_instance_type    = "m6i.large"
# node_group_min_size         = 2
# node_group_desired_size     = 2
# db_instance_class           = "db.t3.medium"
# redis_node_type             = "cache.t3.medium"
# db_multi_az                 = false
